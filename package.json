{
  "name": "radiology-reference",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc -p worker/tsconfig.json",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "vitest run -c vitest.unit.config.ts",
    "test:worker": "vitest run -c vitest.worker.config.ts",
    "e2e": "playwright test",
    "check:dist": "node scripts/check-dist.ts dist",
    "check:links": "node scripts/check-links.ts",
    "worker:dev": "wrangler dev -c worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy -c worker/wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply radref --local -c worker/wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply radref --remote -c worker/wrangler.jsonc",
    "counts": "wrangler d1 execute radref --remote -c worker/wrangler.jsonc --file worker/sql/counts.sql"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "astro": "7.4.13",
    "minisearch": "7.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/vitest-plugin": "1.9.2",
    "@cloudflare/workers-types": "5.20261124.2",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "typescript": "6.0.3",
    "vitest": "5.1.1",
    "wrangler": "4.168.0"
  }
}
