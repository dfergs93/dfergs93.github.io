<div class="search" role="search">
  <label class="visually-hidden" for="q">Find a guideline or calculator</label>
  <input
    id="q"
    class="search-input"
    type="search"
    placeholder="Find a guideline or calculator"
    autocomplete="off"
    spellcheck="false"
    enterkeyhint="go"
    role="combobox"
    aria-expanded="false"
    aria-controls="results-listbox"
    aria-autocomplete="list"
  />
  <kbd class="search-key" aria-hidden="true">/</kbd>
</div>
