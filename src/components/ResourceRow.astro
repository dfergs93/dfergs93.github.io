---
// The only place row markup is written. Client code clones rows from #all-resources.
import { areaLabel } from '../../shared/areas.ts';
import { CALCULATORS } from '../../shared/calculators/index.ts';
import type { Resource } from '../../shared/schema.ts';
import StarIcon from './StarIcon.astro';

interface Props {
  resource: Resource;
}

const { resource: r } = Astro.props;
// Calculators with a module get a quick-view button (shown by the page script).
const quick = CALCULATORS.has(r.id);
---
<li class="row" data-id={r.id}>
  <button class="star" type="button" data-id={r.id} aria-pressed="false" aria-label="Add to favorites" hidden><StarIcon /></button>
  <div class="row-line">
    <a class="row-link" href={r.url}>
      <span class="row-title">{r.title}</span>
      {r.version !== 'none' && <span class="version">{r.version}</span>}
    </a>
    {r.calculator && <span class="calc calc-label">calc</span>}
    {quick && (
      <button class="calc calc-toggle" type="button" aria-expanded="false" aria-label={`Quick calc: ${r.title}`} hidden>calc</button>
    )}
    <span class="row-area">{areaLabel(r.area)}</span>
    <span class="fav-move">
      <button class="fav-up" type="button" aria-label={`Move ${r.title} up`}><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4 10l4-4 4 4" /></svg></button>
      <button class="fav-down" type="button" aria-label={`Move ${r.title} down`}><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4 6l4 4 4-4" /></svg></button>
    </span>
  </div>
  <p class="summary">{r.summary}</p>
</li>
