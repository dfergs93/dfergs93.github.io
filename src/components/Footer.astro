---
import { SITE } from '../../shared/site.ts';
---
<footer class="site-footer">
  <p>A reference, not a substitute for clinical judgement.</p>
  <p>{SITE.credit} · <a href="/about/">About</a></p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 24px;
    margin-top: 40px;
    padding: 16px 0 24px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.8667rem;
  }
  .site-footer p { margin: 0; }
  .site-footer a:hover { color: var(--ink); transition-delay: var(--hover-delay); }
</style>
